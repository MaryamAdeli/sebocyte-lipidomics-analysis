## Volcano plots

# =========================
# 11. Volcano plot functions
# =========================
def clean_compound_label(row, max_len=35):
    name = str(row["Name"]).strip() if "Name" in row.index and pd.notna(row["Name"]) else ""
    if name == "" or name.lower() in ["nan", "unknown", "unnamed", "na", "none"]:
        fid = str(row["Feature_ID"])
        label = fid.split("_mz")[0] if "_mz" in fid else fid
    else:
        label = name
    return label[:max_len] + "..." if len(label) > max_len else label

def volcano_analysis(control_group, treatment_group, log2fc_threshold=1.0, p_threshold=0.05, use_fdr=False, label_each_side=10):
    control_cols = GROUP_SAMPLES[control_group]
    treatment_cols = GROUP_SAMPLES[treatment_group]
    results = []
    for idx in area_log2.index:
        control_vals = area_log2.loc[idx, control_cols].values.astype(float)
        treatment_vals = area_log2.loc[idx, treatment_cols].values.astype(float)
        mean_control = np.mean(control_vals)
        mean_treatment = np.mean(treatment_vals)
        log2fc = mean_treatment - mean_control
        stat, pval = ttest_ind(treatment_vals, control_vals, equal_var=False, nan_policy="omit")
        results.append({
            "index": idx,
            "Feature_ID": df_filtered.loc[idx, "Feature_ID"],
            "Name": df_filtered.loc[idx, "Name"],
            "m/z": df_filtered.loc[idx, "m/z"],
            "RT [min]": df_filtered.loc[idx, "RT [min]"],
            "mean_control_log2": mean_control,
            "mean_treatment_log2": mean_treatment,
            "log2FC": log2fc,
            "p_value": pval,
        })
    res_df = pd.DataFrame(results)
    res_df["p_value"] = pd.to_numeric(res_df["p_value"], errors="coerce")
    res_df = res_df.dropna(subset=["p_value"]).copy()
    res_df["FDR"] = multipletests(res_df["p_value"], method="fdr_bh")[1]
    sig_col = "FDR" if use_fdr else "p_value"
    res_df["minus_log10_sig"] = -np.log10(res_df[sig_col].clip(lower=1e-300))
    res_df["Significance"] = "Not significant"
    res_df.loc[(res_df["log2FC"] >= log2fc_threshold) & (res_df[sig_col] < p_threshold), "Significance"] = "Up"
    res_df.loc[(res_df["log2FC"] <= -log2fc_threshold) & (res_df[sig_col] < p_threshold), "Significance"] = "Down"

    suffix = "FDR" if use_fdr else "pvalue"
    results_file = TABLE_DIR / f"Volcano_results_{treatment_group}_vs_{control_group}_{suffix}.csv"
    res_df.to_csv(results_file, index=False)

    fig, ax = plt.subplots(figsize=(7.2, 6.2))
    color_map = {"Not significant": "lightgray", "Up": "#D55E00", "Down": "#0072B2"}
    for category in ["Not significant", "Down", "Up"]:
        subset = res_df[res_df["Significance"] == category]
        ax.scatter(subset["log2FC"], subset["minus_log10_sig"],
                   s=32 if category == "Not significant" else 42,
                   c=color_map[category], label=category,
                   alpha=0.75 if category == "Not significant" else 0.9,
                   edgecolors="none")

    ax.axvline(log2fc_threshold, linestyle="--", linewidth=1, color="gray")
    ax.axvline(-log2fc_threshold, linestyle="--", linewidth=1, color="gray")
    ax.axhline(-np.log10(p_threshold), linestyle="--", linewidth=1, color="gray")

    up_df = res_df[res_df["Significance"] == "Up"].sort_values(sig_col).head(label_each_side)
    down_df = res_df[res_df["Significance"] == "Down"].sort_values(sig_col).head(label_each_side)
    labeled_df = pd.concat([up_df, down_df]).copy()
    texts = []
    for _, row in labeled_df.iterrows():
        texts.append(ax.text(row["log2FC"], row["minus_log10_sig"], clean_compound_label(row), fontsize=8))
    if ADJUST_TEXT_AVAILABLE and len(texts) > 0:
        adjust_text(texts, ax=ax, arrowprops=dict(arrowstyle="-", color="black", lw=0.5),
                    expand_points=(1.3, 1.5), expand_text=(1.2, 1.4), force_text=0.8, force_points=0.4)

    ax.set_xlabel("log2 fold change", fontsize=12)
    ax.set_ylabel("-log10(FDR)" if use_fdr else "-log10(p-value)", fontsize=12)
    ax.set_title(f"{treatment_group} vs {control_group}", fontsize=14)
    ax.legend(frameon=False, fontsize=10)
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.tick_params(axis="both", labelsize=10)
    plt.tight_layout()

    plot_png = FIGURE_DIR / f"Volcano_{treatment_group}_vs_{control_group}_{suffix}.png"
    plot_pdf = FIGURE_DIR / f"Volcano_{treatment_group}_vs_{control_group}_{suffix}.pdf"
    plt.savefig(plot_png, dpi=DPI, bbox_inches="tight")
    plt.savefig(plot_pdf, bbox_inches="tight")
    plt.show()
    print(f"{treatment_group} vs {control_group}")
    print(res_df["Significance"].value_counts())
    print("Saved:", results_file)
    print("Saved:", plot_png)
    print("Saved:", plot_pdf)
    return res_df

# =========================
# 12. Run volcano comparisons
# =========================
USE_FDR_FOR_PLOT = False  # FDR values are still exported in result tables

exo1_vs_control = volcano_analysis("Control", "Exo1", log2fc_threshold=1.0, p_threshold=0.05,
                                   use_fdr=USE_FDR_FOR_PLOT, label_each_side=10)
exo5_vs_control = volcano_analysis("Control", "Exo5", log2fc_threshold=1.0, p_threshold=0.05,
                                   use_fdr=USE_FDR_FOR_PLOT, label_each_side=10)
msc_vs_control = volcano_analysis("Control", "MSC", log2fc_threshold=1.0, p_threshold=0.05,
                                  use_fdr=USE_FDR_FOR_PLOT, label_each_side=10)

## Lipid-class-level analysis

# =========================
# 13. Lipid class extraction
# =========================
def extract_lipid_class(name):
    x = str(name).strip().replace(" ", "")
    x_upper = x.upper()
    patterns = [
        ("LPC", r"^LPC"), ("LPE", r"^LPE"), ("LPI", r"^LPI"), ("LPS", r"^LPS"), ("LPG", r"^LPG"), ("LPA", r"^LPA"),
        ("PC", r"^PC[\(O\-P0-9_:]"), ("PE", r"^PE[\(O\-P0-9_:]"), ("PI", r"^PI[\(O\-P0-9_:]"),
        ("PS", r"^PS[\(O\-P0-9_:]"), ("PG", r"^PG[\(O\-P0-9_:]"), ("PA", r"^PA[\(O\-P0-9_:]"),
        ("DG", r"^DG"), ("TG", r"^TG"),
        ("Cer", r"^CER"), ("SM", r"^SM"), ("GlcCer", r"^GLCCER"), ("PI-Cer", r"^PI-CER"), ("PE-Cer", r"^PE-CER"),
        ("FAHFA", r"^FAHFA"), ("Acylcarnitine", r".*CARNITINE"),
        ("Fatty acid", r".*ACID$|.*ANOICACID|.*ENOICACID|.*DIENOICACID|.*TRIENOICACID"),
        ("Sterol", r".*STEROL|.*VITAMIND|.*ESTRADIOL"),
    ]
    for lipid_class, pattern in patterns:
        if re.match(pattern, x_upper):
            return lipid_class
    return "Other"

df_class = df_filtered.copy()
df_class["Lipid_Class"] = df_class["Name"].apply(extract_lipid_class)
class_counts_file = TABLE_DIR / "lipid_class_feature_counts.csv"
df_class["Lipid_Class"].value_counts().rename_axis("Lipid_Class").reset_index(name="Feature_Count").to_csv(class_counts_file, index=False)
print("Lipid class counts:")
print(df_class["Lipid_Class"].value_counts())
print("Saved:", class_counts_file)

# =========================
# 14. Class-level abundance and statistics
# =========================
class_area = df_class.groupby("Lipid_Class")[SAMPLE_COLS].sum()
class_area_file = TABLE_DIR / "lipid_class_area_raw.csv"
class_area.to_csv(class_area_file)

class_norm = median_normalize(class_area)
class_log2 = log2_transform(class_norm)
class_log2_file = TABLE_DIR / "lipid_class_area_median_log2.csv"
class_log2.to_csv(class_log2_file)

anova_results = []
for lipid_class in class_log2.index:
    values_by_group = [class_log2.loc[lipid_class, GROUP_SAMPLES[g]].values.astype(float) for g in GROUP_ORDER]
    stat, pval = f_oneway(*values_by_group)
    group_means = {g: class_log2.loc[lipid_class, GROUP_SAMPLES[g]].mean() for g in GROUP_ORDER}
    anova_results.append({
        "Lipid_Class": lipid_class,
        "ANOVA_p_value": pval,
        "Mean_Control_log2": group_means["Control"],
        "Mean_Exo1_log2": group_means["Exo1"],
        "Mean_Exo5_log2": group_means["Exo5"],
        "Mean_MSC_log2": group_means["MSC"],
        "Exo1_vs_Control_log2diff": group_means["Exo1"] - group_means["Control"],
        "Exo5_vs_Control_log2diff": group_means["Exo5"] - group_means["Control"],
        "MSC_vs_Control_log2diff": group_means["MSC"] - group_means["Control"],
    })
class_anova = pd.DataFrame(anova_results)
class_anova["ANOVA_FDR"] = multipletests(class_anova["ANOVA_p_value"], method="fdr_bh")[1]
class_anova = class_anova.sort_values("ANOVA_p_value")
class_anova_file = TABLE_DIR / "lipid_class_ANOVA_results.csv"
class_anova.to_csv(class_anova_file, index=False)

pairwise_results = []
for lipid_class in class_log2.index:
    for treatment in ["Exo1", "Exo5", "MSC"]:
        treatment_vals = class_log2.loc[lipid_class, GROUP_SAMPLES[treatment]].values.astype(float)
        control_vals = class_log2.loc[lipid_class, GROUP_SAMPLES["Control"]].values.astype(float)
        stat, pval = ttest_ind(treatment_vals, control_vals, equal_var=False)
        pairwise_results.append({
            "Lipid_Class": lipid_class,
            "Comparison": f"{treatment}_vs_Control",
            "Mean_Treatment_log2": np.mean(treatment_vals),
            "Mean_Control_log2": np.mean(control_vals),
            "log2_difference": np.mean(treatment_vals) - np.mean(control_vals),
            "p_value": pval,
        })
class_pairwise = pd.DataFrame(pairwise_results)
class_pairwise["FDR"] = np.nan
for comp in class_pairwise["Comparison"].unique():
    mask = class_pairwise["Comparison"] == comp
    class_pairwise.loc[mask, "FDR"] = multipletests(class_pairwise.loc[mask, "p_value"], method="fdr_bh")[1]
class_pairwise = class_pairwise.sort_values(["Comparison", "p_value"])
class_pairwise_file = TABLE_DIR / "lipid_class_pairwise_vs_Control_results.csv"
class_pairwise.to_csv(class_pairwise_file, index=False)

print("Saved:", class_area_file)
print("Saved:", class_log2_file)
print("Saved:", class_anova_file)
print("Saved:", class_pairwise_file)
class_anova

# =========================
# 15. Lipid class boxplots
# =========================
boxplot_dir = FIGURE_DIR / "Lipid_class_boxplots"
boxplot_dir.mkdir(exist_ok=True)

for lipid_class in class_log2.index:
    fig, ax = plt.subplots(figsize=(5.5, 4.5))
    values = [class_log2.loc[lipid_class, GROUP_SAMPLES[group]].values.astype(float) for group in GROUP_ORDER]
    ax.boxplot(values, labels=GROUP_ORDER, showfliers=True)
    for i, group in enumerate(GROUP_ORDER, start=1):
        y = class_log2.loc[lipid_class, GROUP_SAMPLES[group]].values.astype(float)
        x = np.random.normal(i, 0.04, size=len(y))
        ax.scatter(x, y, s=35, alpha=0.8, color=GROUP_COLORS[group], edgecolors="black", linewidths=0.3)
    ax.set_title(lipid_class)
    ax.set_ylabel("log2 normalized summed abundance")
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    plt.tight_layout()

    safe_name = safe_filename(lipid_class)
    out_png = boxplot_dir / f"{safe_name}_boxplot.png"
    out_pdf = boxplot_dir / f"{safe_name}_boxplot.pdf"
    plt.savefig(out_png, dpi=DPI, bbox_inches="tight")
    plt.savefig(out_pdf, bbox_inches="tight")
    plt.show()
print("Saved lipid class boxplots in:", boxplot_dir)

