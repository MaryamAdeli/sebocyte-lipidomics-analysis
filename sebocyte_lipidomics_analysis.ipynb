df_processed = df_filtered.loc[valid_features, ["Feature_ID", "Name", "m/z", "RT [min]"]].copy()
df_processed = pd.concat([df_processed, area_pareto], axis=1)
processed_file = TABLE_DIR / "lipidomics_processed_median_log2_pareto.csv"
df_processed.to_csv(processed_file, index=False)

