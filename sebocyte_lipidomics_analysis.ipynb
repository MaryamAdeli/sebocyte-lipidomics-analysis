# =========================
# 3. Helper functions
# =========================
def clean_text(x):
    x = str(x).strip()
    x = re.sub(r"\s+", "_", x)
    x = re.sub(r"[^\w\-\.\(\):;]+", "", x)
    return x

def safe_filename(x):
    return re.sub(r'[\\/*?:"<>|]', "_", str(x))

def check_required_columns(df, required_cols):
    missing = [c for c in required_cols if c not in df.columns]
    if missing:
        raise ValueError(f"Missing required columns: {missing}")

def create_feature_id(df):
    df = df.copy()
    df["Feature_ID"] = (
        df["Name"].apply(clean_text)
        + "_mz" + pd.to_numeric(df["m/z"], errors="coerce").round(4).astype(str)
        + "_RT" + pd.to_numeric(df["RT [min]"], errors="coerce").round(2).astype(str)
    )
    if df["Feature_ID"].duplicated().any():
        df["Feature_ID"] = df["Feature_ID"] + "_ID" + df.index.astype(str)
    return df

def median_normalize(data):
    sample_medians = data.median(axis=0, skipna=True)
    global_median = sample_medians.median()
    return data.div(sample_medians, axis=1) * global_median

def log2_transform(data):
    data = data.copy()
    min_positive = data[data > 0].min().min()
    if pd.isna(min_positive) or min_positive <= 0:
        raise ValueError("No positive values available for log2 transformation.")
    data = data.replace(0, min_positive / 2)
    return np.log2(data)

def pareto_scale(data_log2):
    feature_means = data_log2.mean(axis=1)
    feature_sds = data_log2.std(axis=1).replace(0, np.nan)
    scaled = data_log2.sub(feature_means, axis=0).div(np.sqrt(feature_sds), axis=0)
    valid = scaled.notna().all(axis=1)
    return scaled[valid].copy(), valid

def draw_confidence_ellipse(x, y, ax, n_std=1.8, edgecolor="black", facecolor="none", alpha=0.15, linewidth=2):
    if len(x) < 2:
        return
    cov = np.cov(x, y)
    if np.any(np.isnan(cov)) or np.linalg.det(cov) == 0:
        return
    mean_x, mean_y = np.mean(x), np.mean(y)
    eigvals, eigvecs = np.linalg.eigh(cov)
    order = eigvals.argsort()[::-1]
    eigvals, eigvecs = eigvals[order], eigvecs[:, order]
    angle = np.degrees(np.arctan2(*eigvecs[:, 0][::-1]))
    width, height = 2 * n_std * np.sqrt(eigvals)
    ellipse = Ellipse((mean_x, mean_y), width=width, height=height, angle=angle,
                      edgecolor=edgecolor, facecolor=facecolor, linewidth=linewidth, alpha=alpha)
    ax.add_patch(ellipse)

